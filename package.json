{
  "name": "argos-mcp",
  "version": "6.2.0",
  "description": "Argos - the hundred-eyed MCP server for SQL databases, with support for PostgreSQL, MySQL, SQLite, MSSQL, and SSH tunnels",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "argos": "./dist/cli.js",
    "argos-mcp": "./dist/index.js",
    "argos-setup": "./dist/setup.js"
  },
  "scripts": {
    "build": "npm run clean && tsc && chmod +x dist/cli.js dist/index.js dist/setup.js",
    "build:fast": "npm run clean && npm run build:esbuild",
    "build:esbuild": "esbuild src/cli.ts src/index.ts src/setup.ts --bundle --platform=node --outdir=dist --external:mssql --external:mysql2 --external:pg --external:sqlite3 --external:ssh2 --external:ini --format=esm --sourcemap --minify && chmod +x dist/cli.js dist/index.js dist/setup.js",
    "build:production": "npm run clean && npm run lint && npm run test && npm run build",
    "build:watch": "tsc --watch",
    "dev": "npm run build:watch",
    "start": "node dist/cli.js serve",
    "setup": "node dist/cli.js setup",
    "test": "jest --passWithNoTests",
    "test:unit": "jest tests/unit --passWithNoTests",
    "test:integration": "jest tests/integration --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "lint": "eslint 'src/**/*.ts' --fix",
    "lint:check": "eslint 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "type-check": "tsc --noEmit",
    "clean": "node -e \"const fs = require('fs'); if (fs.existsSync('dist')) fs.rmSync('dist', {recursive: true, force: true});\"",
    "prebuild": "npm run type-check",
    "validate": "npm run lint:check && npm run format:check && npm run type-check && npm run type-check:tests && npm run type-check:examples && npm run test && npm run test:mod && npm run typecheck:mod",
    "validate-docs": "node scripts/validate-documentation.js",
    "prepack": "npm run build:production",
    "generate-template": "node dist/cli.js setup --template",
    "prepare": "husky",
    "type-check:tests": "tsc -p tests/tsconfig.json --noEmit",
    "type-check:examples": "tsc -p examples/tsconfig.json --noEmit",
    "test:mod": "vitest run",
    "typecheck:mod": "tsc -p plugin/hooks/tsconfig.json && tsc -p plugin/hooks/tsconfig.spec.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AraneaDev/argos.git"
  },
  "homepage": "https://github.com/AraneaDev/argos#readme",
  "bugs": {
    "url": "https://github.com/AraneaDev/argos/issues"
  },
  "lint-staged": {
    "{src,tests}/**/*.ts": "prettier --write",
    "src/**/*.ts": "eslint --fix"
  },
  "overrides": {
    "qs": "^6.15.2"
  },
  "keywords": [
    "argos",
    "argos-mcp",
    "claude",
    "claude-code",
    "mcp",
    "sql",
    "database",
    "postgresql",
    "mysql",
    "sqlite",
    "mssql",
    "typescript",
    "ai"
  ],
  "dependencies": {
    "@azure/identity": "4.14.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ini": "7.0.0",
    "mssql": "12.7.11",
    "mysql2": "3.24.6",
    "pg": "8.23.1",
    "sqlite3": "6.0.1",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/jest-runner": "^10.1.1",
    "@swc/core": "1.16.20",
    "@swc/jest": "0.2.39",
    "@types/ini": "4.1.1",
    "@types/jest": "30.0.0",
    "@types/mssql": "12.3.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/sqlite3": "3.1.11",
    "@types/ssh2": "1.15.6",
    "@xterm/xterm": "6.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "globals": "17.13.0",
    "husky": "^9.1.7",
    "jest": "30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "puppeteer-core": "25.16.0",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=10.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ]
}
